#!/usr/bin/env bash
# Join the Conquer network (plan.md §4.6, D6: OIDC). There is no key: `tailscale up --login-server`
# prints a login URL that a person opens in a browser; the daemon finishes the join when the login
# completes. This task is idempotent and never blocks a bootstrap: connected means done, otherwise it
# prints the URL and exits 0 so converge can be re-run after the login.
#
#   tailscale-join --login-server <url>
set -uo pipefail

login_server=''
while [ $# -gt 0 ]; do
  case "$1" in
    --login-server) login_server=$2; shift 2 ;;
    *) echo "tailscale-join: unknown argument: $1" >&2; exit 2 ;;
  esac
done
[ -n "$login_server" ] || { echo "tailscale-join: --login-server is required" >&2; exit 2; }

export PATH="$HOME/.local/bin:/opt/homebrew/bin:/home/linuxbrew/.linuxbrew/bin:$PATH"
command -v tailscale >/dev/null 2>&1 || { echo "tailscale-join: tailscale is not installed yet; converge again"; exit 0; }

# `status` is readable by any user. `up` talks to the Linux system daemon as root; `sudo env PATH=…`
# keeps our PATH so the same binary (or a test fake) is used. The macOS app's CLI runs as the user.
up_prefix=()
if [ "$(uname -s)" = Linux ] && [ "$(id -u)" != 0 ]; then up_prefix=(sudo -n env "PATH=$PATH"); fi

# Every call to the CLI is bounded (perl's alarm is portable; GNU timeout is not on macOS): the macOS
# app's CLI blocks forever until the app has been opened once and its VPN configuration approved
# (ADR 0001 F-38), and a converge must never hang on that.
# bounded <seconds> <command...>: runs the command in its own process group and kills the whole group on
# timeout, so a child left behind (sudo's command, a wrapper's exec target) cannot keep the pipe open.
bounded() {
  perl -e 'my $t = shift; setpgrp(0, 0); my $pid = fork; if (!$pid) { exec @ARGV or exit 127 } $SIG{ALRM} = sub { kill "TERM", -$$; exit 124 }; alarm $t; waitpid $pid, 0; exit $? >> 8' "$@"
}
state=$(bounded 10 tailscale status --json 2>/dev/null | sed -n 's/.*"BackendState": *"\([A-Za-z]*\)".*/\1/p' | head -1)
if [ "$state" = Running ]; then
  echo "tailscale-join: already connected"
  exit 0
fi
if [ -z "$state" ]; then
  echo "tailscale-join: the Tailscale daemon did not answer within 10 s"
  if [ "$(uname -s)" = Darwin ]; then
    echo "tailscale-join: open /Applications/Tailscale.app once and approve its VPN configuration, then run 'mise run tailscale-join'"
    exit 0
  fi
fi

echo "tailscale-join: requesting a login from $login_server"
# `tailscale up` blocks until the login completes; give it 20 s to print the URL.
out=$(bounded 20 ${up_prefix[@]+"${up_prefix[@]}"} tailscale up --login-server "$login_server" 2>&1 || true)
url=$(printf '%s\n' "$out" | grep -oE 'https://[^[:space:]]+' | head -1)
if [ -n "$url" ]; then
  echo "tailscale-join: open this URL in a browser to finish joining (--login-server $login_server):"
  echo "  $url"
  echo "tailscale-join: then run 'mise run tailscale-join' again, or a converge, to confirm"
else
  echo "tailscale-join: no login URL yet; tailscale said:"
  printf '%s\n' "$out" | sed 's/^/  /' | head -8
fi
exit 0
