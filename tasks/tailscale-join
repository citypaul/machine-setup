#!/usr/bin/env bash
# Join the Conquer network (plan.md §4.6, D6: OIDC). There is no key: `tailscale up --login-server`
# prints a login URL that a person opens in a browser; the daemon finishes the join when the login
# completes. This task is idempotent and never blocks a bootstrap: connected means done, otherwise it
# prints the URL and exits 0 so converge can be re-run after the login.
#
#   tailscale-join --login-server <url>
set -uo pipefail

login_server=''
while [ $# -gt 0 ]; do
  case "$1" in
    --login-server) login_server=$2; shift 2 ;;
    *) echo "tailscale-join: unknown argument: $1" >&2; exit 2 ;;
  esac
done
[ -n "$login_server" ] || { echo "tailscale-join: --login-server is required" >&2; exit 2; }

export PATH="$HOME/.local/bin:/opt/homebrew/bin:/home/linuxbrew/.linuxbrew/bin:$PATH"
command -v tailscale >/dev/null 2>&1 || { echo "tailscale-join: tailscale is not installed yet; converge again"; exit 0; }

# The Linux CLI talks to tailscaled as root; the macOS app's CLI runs as the user.
ts() { if [ "$(uname -s)" = Linux ] && [ "$(id -u)" != 0 ]; then sudo -n tailscale "$@"; else tailscale "$@"; fi; }

state=$(ts status --json 2>/dev/null | sed -n 's/.*"BackendState": *"\([A-Za-z]*\)".*/\1/p' | head -1)
if [ "$state" = Running ]; then
  echo "tailscale-join: already connected"
  exit 0
fi

echo "tailscale-join: requesting a login from $login_server"
out=$(timeout 20 ts up --login-server "$login_server" 2>&1 || true)
url=$(printf '%s\n' "$out" | grep -oE 'https://[^[:space:]]+' | head -1)
if [ -n "$url" ]; then
  echo "tailscale-join: open this URL in a browser to finish joining (--login-server $login_server):"
  echo "  $url"
  echo "tailscale-join: then run 'mise run tailscale-join' again, or a converge, to confirm"
else
  echo "tailscale-join: no login URL yet; tailscale said:"
  printf '%s\n' "$out" | sed 's/^/  /' | head -8
fi
exit 0
