#!/usr/bin/env bash
# Ghostty has no apt repository; Ghostty's own docs point Ubuntu users at the ghostty-ubuntu builds
# (github.com/mkasberg/ghostty-ubuntu), one .deb per Ubuntu release and architecture (ADR 0001 D-31).
# Installed once; afterwards `mise run ghostty-linux` only reports. Advisory on a release or
# architecture without a build. Linux only; a Mac gets the cask.
set -uo pipefail
[ "$(uname -s)" = Linux ] || { echo "ghostty-linux: Linux only; skipping"; exit 0; }
if dpkg -s ghostty >/dev/null 2>&1; then
  echo "ghostty-linux: already installed ($(dpkg-query -W -f='${Version}' ghostty))"
  exit 0
fi
# shellcheck disable=SC1091
. /etc/os-release
[ "${ID:-}" = ubuntu ] || { echo "ghostty-linux: no ghostty-ubuntu build for ${ID:-this distribution}; skipping"; exit 0; }
arch=$(dpkg --print-architecture)
as_root() { if [ "$(id -u)" = 0 ]; then "$@"; else sudo -n "$@"; fi; }
# The latest release tag comes from GitHub's redirect (no API call, so no rate limit in CI):
# tag 1.3.1-0-ppa2 names the file ghostty_1.3.1-0.ppa2_<arch>_<release>.deb.
latest=$(curl -fsSIL -o /dev/null -w '%{url_effective}' --max-time 30 https://github.com/mkasberg/ghostty-ubuntu/releases/latest 2>/dev/null)
tag=${latest##*/tag/}
[ -n "$tag" ] && [ "$tag" != "$latest" ] || { echo "ghostty-linux: warning: could not resolve the latest release; re-run 'mise run ghostty-linux' later"; exit 0; }
version=$(printf '%s' "$tag" | sed 's/-\([^-]*\)$/.\1/')
asset="ghostty_${version}_${arch}_${VERSION_ID}.deb"
url="https://github.com/mkasberg/ghostty-ubuntu/releases/download/$tag/$asset"
tmp=$(mktemp -d "${TMPDIR:-/tmp}/ghostty.XXXXXX") || exit 1
trap 'rm -rf "$tmp"' EXIT
echo "ghostty-linux: downloading $asset"
if ! curl -fsSL --max-time 300 "$url" -o "$tmp/ghostty.deb"; then
  echo "ghostty-linux: warning: no build at $url (release $VERSION_ID on $arch); re-run later or install Ghostty another way"
  exit 0
fi
if as_root env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "$tmp/ghostty.deb"; then
  echo "ghostty-linux: installed $asset"
else
  echo "ghostty-linux: error: apt-get could not install $asset" >&2
  exit 1
fi
exit 0
