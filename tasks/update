#!/usr/bin/env bash
# Upgrade on purpose (plan.md §4.4, ADR 0001 D-35): converge never upgrades, this shows the plan and
# then upgrades the declared packages and the mise tools when told to. mise's own version is pinned
# by bootstrap.sh and the skills by mise.toml; both change through the repo, not here.
# Usage: tasks/update [--dry-run] [--yes]
set -uo pipefail
# Upgrades run with stdin, stdout and stderr only: a cask upgrade can start a daemon (the 1Password
# CLI's completion generation) that keeps every descriptor it inherits (ADR 0001 F-41).
stdio_only() { perl -e 'use POSIX (); POSIX::close($_) for 3 .. 1023; exec { $ARGV[0] } @ARGV or die "stdio_only: cannot run $ARGV[0]: $!\n"' "$@"; }
# launchd starts macOS processes, Terminal's shells among them, with a soft limit of 256 open files;
# mise's npm installs open more and fail with "Too many open files" (ADR 0001 F-55). Raise the soft
# limit for the upgrades to 10240, or to the hard limit when that is lower. Never lower it.
raise_open_files() {
  soft=$(ulimit -Sn 2>/dev/null) || return 0
  [ "$soft" = unlimited ] || [ "$soft" -ge 10240 ] || ulimit -Sn 10240 2>/dev/null || ulimit -Sn "$(ulimit -Hn)" 2>/dev/null || true
}
raise_open_files
checkout=$(cd "$(dirname "$0")/.." && pwd)
dry_run=0 yes=0
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run|-n) dry_run=1; shift ;;
    --yes|-y) yes=1; shift ;;
    -h|--help) echo "usage: update [--dry-run] [--yes]"; exit 0 ;;
    *) echo "update: unknown argument: $1" >&2; exit 2 ;;
  esac
done
export PATH="$PATH:$HOME/.local/bin:/opt/homebrew/bin:/home/linuxbrew/.linuxbrew/bin"
mise_bin=${MISE_BIN:-}
[ -n "$mise_bin" ] && [ -x "$mise_bin" ] || mise_bin=$(command -v mise 2>/dev/null || echo "$HOME/.local/bin/mise")
[ -x "$mise_bin" ] || { echo "update: mise is not installed; run $checkout/bootstrap.sh" >&2; exit 1; }
cd "$checkout" || exit 1
export MISE_YES=1

echo "update: packages (declared by this checkout; the plan first)"
stdio_only "$mise_bin" bootstrap packages upgrade --dry-run 2>&1 | sed 's/^/  /'
echo "update: tools (mise [tools])"
stdio_only "$mise_bin" upgrade --dry-run 2>&1 | sed 's/^/  /'
pinned=$(sed -n 's/^claude_skills_version = "\(.*\)"$/\1/p' mise.toml)
# shellcheck disable=SC2016  # a literal ${ in the pattern
mise_pin=$(sed -n 's/^MISE_PIN="\${MISE_VERSION:-\(v[^}]*\)}"$/\1/p' bootstrap.sh)
echo "update: skills pinned to ${pinned:-?} and mise to ${mise_pin:-?}; both change in the repo (mise.toml, bootstrap.sh), not here"

if [ "$dry_run" = 1 ]; then
  echo "update: dry run, nothing changed"
  exit 0
fi
if [ "$yes" != 1 ]; then
  if [ -t 0 ]; then
    printf 'update: apply these upgrades? [y/N] '
    read -r reply
    case "$reply" in y|Y|yes) ;; *) echo "update: nothing changed"; exit 0 ;; esac
  else
    echo "update: nothing changed; re-run with --yes to apply (no terminal to ask)"
    exit 0
  fi
fi
echo "update: upgrading packages"
stdio_only "$mise_bin" bootstrap packages upgrade --yes || { echo "update: package upgrade failed" >&2; exit 1; }
echo "update: upgrading tools"
stdio_only "$mise_bin" upgrade || { echo "update: tool upgrade failed" >&2; exit 1; }
echo "update: checking the declared state afterwards"
if "$mise_bin" bootstrap status --missing >/dev/null 2>&1; then echo "update: done, no drift"; else echo "update: done; something drifted, run $checkout/bootstrap.sh --yes"; exit 1; fi
