#!/usr/bin/env bash
# Journaled migration from a GNU Stow layout to this checkout's mise dotfile groups (plan.md §4.11).
#
#   migrate --checkout <dir> [--stow-dir ~/.dotfiles] [--skip-prerequisites] [--force] [--yes] [--dry-run]
#
# Every write is journaled under ~/.local/state/machine-setup/migration/<timestamp>/ and any failure,
# including one during verification, rolls the home directory back to the recorded state: links we
# created are removed, originals (links and files) are restored, directories we created are removed.
# Test hooks: MACHINE_SETUP_MIGRATE_FAIL_AFTER_WRITES=<n>, MACHINE_SETUP_MIGRATE_FAIL_AT=verify.
set -euo pipefail

checkout='' stow_dir="$HOME/.dotfiles" skip_prereqs=0 force=0 dry=0
while [ $# -gt 0 ]; do
  case "$1" in
    --checkout) checkout=$2; shift 2 ;;
    --stow-dir) stow_dir=$2; shift 2 ;;
    --skip-prerequisites) skip_prereqs=1; shift ;;
    --force) force=1; shift ;;
    --yes|-y) shift ;;
    --dry-run) dry=1; shift ;;
    *) echo "migrate: unknown argument: $1" >&2; exit 2 ;;
  esac
done

say() { printf 'migrate: %s\n' "$*"; }
die() { local code=$1; shift; printf 'migrate: error: %s\n' "$*" >&2; exit "$code"; }

[ -n "$checkout" ] || die 2 "--checkout <dir> is required"
checkout=$(cd "$checkout" 2>/dev/null && pwd) || die 2 "checkout $checkout does not exist"
mise_bin=${MISE_BIN:-$(command -v mise 2>/dev/null || echo "$HOME/.local/bin/mise")}
export MISE_YES=1
# The post-dotfiles hooks that `mise dot apply` runs call `mise` by name, so its directory must be on PATH.
mise_dir=$(dirname "$mise_bin")
export PATH="$mise_dir:$PATH:/opt/homebrew/bin:/home/linuxbrew/.linuxbrew/bin"

# 1. Plan: every file the selected groups deploy, from mise's effective configuration.
roots=()
# mise prints paths under the home directory as ~/…; expand them (a checkout at ~/machine-setup).
while IFS= read -r r; do [ -n "$r" ] && roots+=("${r/#\~/$HOME}"); done < <(cd "$checkout" && "$mise_bin" dot status --json 2>/dev/null | jq -r '.files[] | select(.mode=="symlink-each") | .source')
[ ${#roots[@]} -gt 0 ] || die 1 "no dotfile groups are selected in $checkout (run bootstrap.sh --select-only first)"
targets=() sources=()
for root in "${roots[@]}"; do
  while IFS= read -r -d '' f; do
    targets+=("$HOME/${f#"$root"/}")
    sources+=("$f")
  done < <(find "$root" -type f -print0 | sort -z)
done
say "stow dir: $stow_dir; ${#targets[@]} targets from ${#roots[@]} groups"
[ ${#targets[@]} -gt 0 ] || die 1 "the selected groups list no files under ${roots[*]}; is --checkout the machine-setup checkout?"

# Targets that mise renders or copies (template and copy entries) are learned from a dry run: they
# are not linked by the swap, but an existing real file there is just as much a conflict.
rendered=()
while IFS= read -r p; do
  [ -n "$p" ] || continue
  rendered+=("${p/#\~/$HOME}")
done < <(cd "$checkout" && "$mise_bin" dot apply --dry-run 2>/dev/null | sed -n -E 's/^render .* -> (~\/[^ ]+).*/\1/p; s/^cp .* (~\/[^ ]+)$/\1/p' | sort -u)

# GNU Stow "folds" a directory that did not exist yet into one link to the package directory
# (~/.config/ghostty -> ../.dotfiles/ghostty/.config/ghostty). A target under such a link is not a
# real file of the user's; the swap unfolds the directory first, as Stow itself does (ADR 0001 F-48).
stow_real=$(cd "$stow_dir" 2>/dev/null && pwd -P || true)
fold_point() {   # the ancestor of $1 below HOME that is a link into the Stow dir, if any
  local rest=${1#"$HOME"/} p=$HOME part real
  [ -n "$stow_real" ] || return 1
  while [ "${rest#*/}" != "$rest" ]; do
    part=${rest%%/*}; rest=${rest#*/}; p="$p/$part"
    if [ -L "$p" ]; then
      real=$(cd "$p" 2>/dev/null && pwd -P) || return 1
      case "$real/" in "$stow_real"/*) printf '%s\n' "$p"; return 0 ;; esac
      return 1
    fi
  done
  return 1
}
folds=()
for t in ${targets[@]+"${targets[@]}"} ${rendered[@]+"${rendered[@]}"}; do
  f=$(fold_point "$t") || continue
  case " ${folds[*]+"${folds[*]}"} " in *" $f "*) ;; *) folds+=("$f") ;; esac
done
if [ ${#folds[@]} -gt 0 ]; then
  say "Stow folded these directories into single links; the migration will unfold them first:"
  for f in "${folds[@]}"; do printf '  %s -> %s\n' "$f" "$(readlink "$f")"; done
fi

# 2. Conflicts: a real file or directory where a link or a rendered file will go stops the
#    migration unless --force. A file reached through a folded directory is not one.
conflicts=()
for t in ${targets[@]+"${targets[@]}"} ${rendered[@]+"${rendered[@]}"}; do
  case "$t" in *.tera) continue ;; esac
  fold_point "$t" >/dev/null && continue
  if [ -e "$t" ] && [ ! -L "$t" ]; then conflicts+=("$t"); fi
done
if [ ${#conflicts[@]} -gt 0 ] && [ "$force" = 0 ]; then
  say "these targets are real files, not links; re-run with --force to save them in the journal and replace them:"
  printf '  %s\n' "${conflicts[@]}"
  exit 3
fi

# 3. Journal: the pre-migration state of every target, then one line per write.
journal="$HOME/.local/state/machine-setup/migration/$(date +%Y%m%dT%H%M%S)"
mkdir -p "$journal/saved"
# Octal permission bits; GNU `stat -f` is filesystem status, so choose the form by OS.
file_mode() { if [ "$(uname -s)" = Darwin ]; then stat -f '%Lp' "$1"; else stat -c '%a' "$1"; fi; }
describe() {
  local p=$1
  if [ -L "$p" ]; then printf 'link %s\n' "$(readlink "$p")"
  elif [ -d "$p" ]; then echo dir
  elif [ -e "$p" ]; then printf 'file %s %s\n' "$(cksum < "$p" | cut -d' ' -f1)" "$(file_mode "$p")"
  else echo absent; fi
}
for t in ${targets[@]+"${targets[@]}"} ${rendered[@]+"${rendered[@]}"}; do printf '%s\t%s\n' "$t" "$(describe "$t")"; done > "$journal/manifest.before"
: > "$journal/journal.log"
record() { printf '%s\t%s\t%s\n' "$1" "$2" "${3:-}" >> "$journal/journal.log"; }
say "journal: $journal"
if [ "$dry" = 1 ]; then say "dry run: nothing written"; exit 0; fi


# Template and copy sources are not linked by the swap: mise renders or copies them in step 6, and
# anything it creates then is journaled from the apply marker (see step 6).
is_special_source() { case "$1" in *.tera) return 0 ;; esac; return 1; }

# 4. Unfold, prerequisites, then the swap, one target at a time, rolling back everything on any failure.
reverse_lines() { if command -v tac >/dev/null 2>&1; then tac "$1"; else tail -r "$1"; fi; }
rollback() {
  trap - ERR
  set +e
  say "failure detected; rolling back from $journal"
  reverse_lines "$journal/journal.log" | while IFS=$'\t' read -r op path detail; do
    case "$op" in
      link) { [ -L "$path" ] || [ -f "$path" ]; } && rm -f "$path" ;;
      saved-link)
        if [ -d "$path" ] && [ ! -L "$path" ]; then rmdir "$path" 2>/dev/null || say "cannot restore $path: it is not empty"; fi
        [ -d "$path" ] && [ ! -L "$path" ] || ln -sfn "$detail" "$path" ;;
      saved-file) cp -p "$journal/saved/$detail" "$path" ;;
      mkdir) rmdir "$path" 2>/dev/null ;;
    esac
  done
  say "rolled back: nothing from this migration remains"
}
# The ERR trap covers simple commands; a failing ( … ) subshell is handled explicitly with `|| on_error`,
# because macOS's bash 3.2 exits under set -e without running the trap for one (ADR 0001 F-53).
on_error() { rollback; exit 1; }
trap on_error ERR
fail_injected() { say "injected failure $1"; return 1; }

# Unfold: a real directory with the folded one's permissions, and one link per entry, as Stow does.
for d in ${folds[@]+"${folds[@]}"}; do
  src=$(cd "$d" && pwd -P); mode=$(file_mode "$src")
  record saved-link "$d" "$(readlink "$d")"; rm "$d"
  mkdir "$d"; record mkdir "$d"; chmod "$mode" "$d"
  for e in "$src"/* "$src"/.[!.]* "$src"/..?*; do
    [ -e "$e" ] || [ -L "$e" ] || continue
    ln -s "$e" "$d/${e##*/}"; record link "$d/${e##*/}" "$e"
  done
  say "unfolded $d"
done

# Prerequisites while every old link is still in place (plan §4.11 step 2), after the unfold: the
# files phase manages directories such as ~/.gnupg and refuses one that is still a folded link
# (ADR 0001 F-52). A failure here rolls the unfold back.
if [ "$skip_prereqs" = 0 ]; then
  (cd "$checkout" && "$mise_bin" bootstrap --only files,packages,tools --yes) || { say "installing prerequisites failed"; on_error; }
fi


writes=0
for i in "${!targets[@]}"; do
  t=${targets[$i]}; s=${sources[$i]}
  is_special_source "$s" && continue
  d=$(dirname "$t"); missing=()
  while [ ! -d "$d" ]; do missing+=("$d"); d=$(dirname "$d"); done
  for (( k=${#missing[@]}-1; k>=0; k-- )); do mkdir "${missing[$k]}"; record mkdir "${missing[$k]}"; done
  if [ -L "$t" ]; then
    record saved-link "$t" "$(readlink "$t")"; rm "$t"
  elif [ -e "$t" ]; then
    name=$(printf '%s' "${t#"$HOME"/}" | tr '/' '%')
    cp -p "$t" "$journal/saved/$name"; record saved-file "$t" "$name"; rm "$t"
  fi
  ln -s "$s" "$t"; record link "$t" "$s"
  writes=$((writes + 1))
  if [ "${MACHINE_SETUP_MIGRATE_FAIL_AFTER_WRITES:-0}" -gt 0 ] && [ "$writes" -ge "${MACHINE_SETUP_MIGRATE_FAIL_AFTER_WRITES}" ]; then
    fail_injected "after $writes writes"
  fi
done

# 6. Save anything mise will remove as `absent` (for example the retired nvm loader), then let mise
#    record the result; the links already match, so apply registers state without rewriting them.
while IFS= read -r t; do
  [ -n "$t" ] || continue
  t="${t/#\~/$HOME}"
  if [ -L "$t" ]; then record saved-link "$t" "$(readlink "$t")"
  elif [ -f "$t" ]; then name=$(printf '%s' "${t#"$HOME"/}" | tr '/' '%'); cp -p "$t" "$journal/saved/$name"; record saved-file "$t" "$name"
  fi
done < <(cd "$checkout" && "$mise_bin" dot status --json 2>/dev/null | jq -r '.files[] | select(.mode=="absent") | .target')
for t in ${rendered[@]+"${rendered[@]}"}; do
  if [ -L "$t" ]; then record saved-link "$t" "$(readlink "$t")"; rm "$t"
  elif [ -f "$t" ]; then name=$(printf '%s' "${t#"$HOME"/}" | tr '/' '%'); cp -p "$t" "$journal/saved/$name"; record saved-file "$t" "$name"; rm "$t"
  fi
done
touch "$journal/apply-marker"
(cd "$checkout" && "$mise_bin" dot apply --yes >/dev/null) || { say "mise dot apply failed"; on_error; }
# Journal what apply created (rendered templates, copies, their directories) so rollback removes it.
while IFS= read -r p; do
  [ -n "$p" ] || continue
  grep -qF "	$p	" "$journal/journal.log" && continue
  if [ -d "$p" ] && [ ! -L "$p" ]; then record mkdir "$p"; else record link "$p" ""; fi
done < <(find "$HOME" -newer "$journal/apply-marker" \( -type f -o -type l -o -type d \) \
           -not -path "$HOME/.local/*" -not -path "$HOME/.cache/*" -not -path "$HOME/.config/mise/*" -not -path "$journal/*" -not -path "$HOME/.local" 2>/dev/null | sort)
# (sorted parents-first, so the reverse replay in rollback removes files before their directories)

# 7. Verify: everything mise manages is in place and an interactive shell still starts.
if [ "${MACHINE_SETUP_MIGRATE_FAIL_AT:-}" = verify ]; then fail_injected "during verification"; fi
(cd "$checkout" && "$mise_bin" dot status --missing >/dev/null) || { say "verification: mise dot status --missing reports something missing"; on_error; }
if command -v zsh >/dev/null 2>&1; then zsh -ic 'exit 0' >/dev/null 2>&1; fi

trap - ERR
leftover=()
for d in ${folds[@]+"${folds[@]}"}; do
  for e in "$d"/* "$d"/.[!.]* "$d"/..?*; do
    [ -L "$e" ] || continue
    case "$(readlink "$e")" in "$stow_real"/*|"$stow_dir"/*) leftover+=("$e") ;; esac
  done
done
if [ ${#leftover[@]} -gt 0 ]; then
  say "still linked into the old Stow dir (move these before you delete it):"
  printf '  %s\n' "${leftover[@]}"
fi
say "migrated ${#targets[@]} targets into $checkout; originals are kept in $journal/saved"
say "the old Stow dir $stow_dir was not touched; remove it yourself once you are happy"
