#!/usr/bin/env bash
# Install Paul's public CLAUDE.md, skills and agents from citypaul/.dotfiles at an exact reviewed
# release (plan.md §4.7). Runs on every bootstrap and does nothing while the recorded version matches.
#
#   claude-skills --version <tag>
set -euo pipefail

version=''
while [ $# -gt 0 ]; do
  case "$1" in
    --version) version=$2; shift 2 ;;
    *) echo "claude-skills: unknown argument: $1" >&2; exit 2 ;;
  esac
done
[[ "$version" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "claude-skills: --version must be an exact release tag (got '$version')" >&2; exit 2; }

marker="$HOME/.claude/.machine-setup-skills-version"
if [ -f "$marker" ] && [ "$(cat "$marker")" = "$version" ]; then
  echo "claude-skills: already at $version"
  exit 0
fi

# The installer uses npx (skills.sh) and git; node comes from mise's shims.
export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:/opt/homebrew/bin:/home/linuxbrew/.linuxbrew/bin:$PATH"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
echo "claude-skills: installing citypaul/.dotfiles $version (CLAUDE.md, skills, agents, Codex, OpenCode)"
curl -fsSL "https://raw.githubusercontent.com/citypaul/.dotfiles/$version/install-claude.sh" -o "$tmp/install-claude.sh"
chmod +x "$tmp/install-claude.sh"
"$tmp/install-claude.sh" --version "$version" --agent codex --with-opencode
mkdir -p "$HOME/.claude"
printf '%s\n' "$version" > "$marker"
echo "claude-skills: installed $version"
