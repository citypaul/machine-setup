# Managed by machine-setup (plan.md §4.6). Personal hosts belong in ~/.ssh/config.d/ (untracked, so
# they never reach the public repo). Keys live in the 1Password SSH agent on every machine (ADR 0001
# D-21); where its socket does not exist ssh falls back to key files without a word (F-34).
Include ~/.ssh/config.d/*
Host *
{%- if os() == "macos" %}
	IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.group.com.1password/t/agent.sock"
{%- else %}
	IdentityAgent ~/.1password/agent.sock
{%- endif %}
