#!/bin/sh
# Fake brew for check-machine's inventory check: a fixed set of installed top-level formulae and casks.
case "$*" in
  leaves*) printf '%s\n' jq some-tap/tap/zzz-undeclared zzz-unmanaged ;;
  "list --cask"*) printf '%s\n' zzz-cask zzz-renamed ;;
  --caskroom) printf '%s\n' "${FAKE_CASKROOM:-/nonexistent}" ;;
  *) exit 0 ;;
esac
