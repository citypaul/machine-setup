#!/bin/sh
# Fake op whose `whoami` records which descriptors beyond stdio it inherited (the real CLI starts a
# daemon that keeps them open), then reports "not signed in".
open=''
for fd in 3 4 5 6 7 8 9; do if (eval "true >&$fd") 2>/dev/null; then open="$open $fd"; fi; done
echo "open:${open:- none}" > "$FD_PROBE"
exit 1
