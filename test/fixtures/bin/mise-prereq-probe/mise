#!/bin/sh
# Wraps the real mise ($REAL_MISE) for the migration tests. The prerequisites step
# (`mise bootstrap --only …`) installs nothing here; it only fails if ~/.gnupg is still a folded
# link, because the real files phase refuses to manage a directory that is a link (ADR 0001 F-52).
if [ "$1" = bootstrap ] && [ "$2" = --only ]; then
  if [ -L "$HOME/.gnupg" ]; then echo "mise ERROR refusing to replace non-directory path $HOME/.gnupg" >&2; exit 1; fi
  exit 0
fi
exec "$REAL_MISE" "$@"
